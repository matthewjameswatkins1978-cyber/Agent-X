<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentX.Core\AgentX.Core.csproj" />
  </ItemGroup>

  <!-- Beautiful Feed: bundled OFL statics (Geist + Monaspace, required faces only). -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\**\*.otf" />
  </ItemGroup>

  <!-- Focused unit tests cover the internal presentation helpers. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AgentX.App.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>