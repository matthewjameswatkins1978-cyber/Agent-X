<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:AgentX.App"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:core="using:AgentX.Core"
        x:Class="AgentX.App.MainWindow"
        Title="Agent X"
        Width="1200" Height="800" MinWidth="720" MinHeight="480"
        Background="#101318">
  <Grid Margin="12" RowSpacing="8" RowDefinitions="Auto,Auto,*,Auto">
    <!-- Top row: workspace tabs + add. Scrolls on overflow; arrow keys work. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
        <TabStrip x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabs_OnChanged" />
      </ScrollViewer>
      <Button Grid.Column="1" Content="+" Click="AddWorkspace_OnClick"
              ToolTip.Tip="Add project" VerticalAlignment="Center" />
    </Grid>

    <!-- Second row: pages. Live is default. -->
    <TabStrip Grid.Row="1" x:Name="PageTabs" SelectionChanged="PageTabs_OnChanged">
      <TabStripItem Content="Overview" />
      <TabStripItem Content="Live" IsSelected="True" />
      <TabStripItem Content="Settings" />
    </TabStrip>

    <!-- Pages. Only one visible; controls persist so scroll, selection,
         composer input and feed survive page switches. -->
    <Grid Grid.Row="2">
      <!-- Overview: real workspace state, activity, evidence. No invented cards. -->
      <ScrollViewer x:Name="OverviewPanel" IsVisible="False"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
          <TextBlock Text="Workspace" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="WorkspaceDetailText" Text="Select a workspace, then Connect."
                     Foreground="#AAB2BF" FontSize="12" TextWrapping="Wrap" />
          <TextBlock x:Name="OverviewConnectionText" Text="Not connected."
                     Foreground="#AAB2BF" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="Session file" FontWeight="SemiBold" />
          <TextBlock x:Name="OverviewSessionFileText" Text="No session file yet."
                     Foreground="#AAB2BF" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="Recent activity" FontWeight="SemiBold" />
          <TextBlock x:Name="OverviewFactsText" Text="Nothing observed yet."
                     Foreground="#AAB2BF" FontSize="12" TextWrapping="Wrap" />
          <StackPanel x:Name="OverviewMilestones" Spacing="4" />
          <Expander Header="Session map detail" IsExpanded="False" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
              <SelectableTextBlock x:Name="SessionMapText" Text="Connect to Pi to build the session map."
                                     TextWrapping="Wrap" FontSize="12" />
              <Button Content="Copy session map" Click="CopySessionMap_OnClick"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Expander>
          <Expander Header="Packet tools" IsExpanded="False" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
              <TextBlock Text="Large-packet transcript import, preserved byte-for-byte."
                         Foreground="#AAB2BF" FontSize="12" TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal" ItemSpacing="8">
                <Button Content="Paste packet" Click="PastePacket_OnClick" />
                <Button Content="Load 100k" Click="LoadSample_OnClick" />
                <Button Content="Load 25 MiB" Click="Load25MiB_OnClick" />
                <Button Content="Load 1M" Click="LoadMillionSample_OnClick" />
                <Button Content="Copy full text" Click="CopyFullText_OnClick" />
                <Button Content="Export full text" Click="ExportFullText_OnClick" />
              </WrapPanel>
              <ListBox x:Name="TranscriptList" Background="Transparent" BorderThickness="0"
                       MinHeight="120" MaxHeight="260">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="core:TranscriptLine">
                    <TextBlock Text="{Binding Text}" FontFamily="Cascadia Code, Consolas, monospace"
                               FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Margin="6,2" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <!-- Live: dominant conversation + anchored composer. -->
      <Grid x:Name="LivePanel" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
          <WrapPanel Orientation="Horizontal" ItemSpacing="8">
            <Button Content="Connect" Click="ConnectPi_OnClick" />
            <Button Content="Disconnect" Click="DisconnectPi_OnClick" />
            <Button Content="Reconnect" Click="ReconnectPi_OnClick" />
          </WrapPanel>
          <CheckBox Grid.Column="1" x:Name="AutoScrollCheck" Content="Auto-scroll"
                    IsChecked="True" IsCheckedChanged="AutoScrollCheck_OnChanged"
                    VerticalAlignment="Center" />
          <Button Grid.Column="3" Content="Copy selected message" Click="CopySelectedMessage_OnClick"
                  HorizontalAlignment="Left" />
          <Button Grid.Column="4" Content="Copy full conversation" Click="CopyFullConversation_OnClick" />
        </Grid>

        <Grid Grid.Row="1">
          <Border BorderBrush="#343B47" BorderThickness="1" CornerRadius="8" Padding="4">
            <ListBox x:Name="ConversationList" Background="Transparent" BorderThickness="0"
                     SelectionMode="Single">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:ConversationViewItem">
                  <!-- Pi visual grammar: blue user blocks, unboxed assistant
                       Markdown, tinted coherent tool blocks, quiet rows. -->
                  <StackPanel Spacing="2" Margin="8,6"
                              AutomationProperties.Name="{Binding Header}">
                    <Border IsVisible="{Binding IsUser}" Background="{Binding StateBrush}"
                            CornerRadius="6" Padding="10,8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Header}" Foreground="#AAB2BF" FontSize="10" />
                        <SelectableTextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"
                                                 FontSize="13" />
                      </StackPanel>
                    </Border>
                    <StackPanel IsVisible="{Binding IsAssistant}" Spacing="2">
                      <TextBlock Text="{Binding Header}" Foreground="#AAB2BF" FontSize="10" />
                      <app:MarkdownView Markdown="{Binding Markdown}" TextWrapping="Wrap"
                                            FontSize="13" />
                      <SelectableTextBlock IsVisible="{Binding Markdown, Converter={x:Static conv:ObjectConverters.IsNull}}"
                                                 Text="{Binding DisplayText}" TextWrapping="Wrap"
                                                 FontSize="13" />
                    </StackPanel>
                    <Border IsVisible="{Binding IsTool}" Background="{Binding StateBrush}"
                            CornerRadius="6" Padding="10,8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Header}" Foreground="{Binding RoleBrush}"
                                   FontSize="11" FontWeight="SemiBold" />
                        <app:MarkdownView MonoText="{Binding DisplayText}" DiffTint="True"
                                            TextWrapping="Wrap" FontSize="13" />
                        <Button Content="{Binding ExpandLabel}" IsVisible="{Binding CanExpand}"
                                Click="ToolExpand_OnClick" HorizontalAlignment="Left"
                                FontSize="11" Foreground="#82AAFF" Background="Transparent"
                                BorderThickness="0" Padding="0" />
                      </StackPanel>
                    </Border>
                    <StackPanel IsVisible="{Binding IsSystemRow}" Spacing="2">
                      <TextBlock Text="{Binding Header}" Foreground="#AAB2BF" FontSize="10" />
                      <app:MarkdownView MonoText="{Binding DisplayText}" TextWrapping="Wrap"
                                            FontSize="12" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <!-- Inviting empty state, not a wizard. Auto-hides with content. -->
          <Border x:Name="EmptyStatePanel" IsVisible="False" HorizontalAlignment="Center"
                  VerticalAlignment="Center" Background="#161B22" BorderBrush="#343B47"
                  BorderThickness="1" CornerRadius="8" Padding="20" MaxWidth="520">
            <StackPanel Spacing="8">
              <TextBlock Text="Start with your project" FontSize="16" FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock x:Name="EmptyStateText" Text="Connect a workspace, then ask your first question."
                         Foreground="#AAB2BF" FontSize="12" TextWrapping="Wrap"
                         HorizontalAlignment="Center" TextAlignment="Center" />
              <Button Content="List the top-level files and explain the layout"
                      Tag="List the top-level files in this project and explain the layout briefly."
                      Click="Suggestion_OnClick" HorizontalAlignment="Stretch" />
              <Button Content="Summarise recent changes" Tag="Summarise the recent changes in this project."
                      Click="Suggestion_OnClick" HorizontalAlignment="Stretch" />
              <Button Content="What tests exist and how do I run them"
                      Tag="What tests exist in this project and how do I run them?"
                      Click="Suggestion_OnClick" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#343B47" BorderThickness="1" CornerRadius="8" Padding="8">
          <StackPanel Spacing="6">
            <TextBlock x:Name="PiActivityText" Text="" Foreground="#7DD3A8" FontSize="12"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="PiRunStatus" Text="" Foreground="#AAB2BF" FontSize="12"
                       TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox x:Name="PiPromptBox" PlaceholderText="Ask Pi anything… (Ctrl+Enter to send)"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="220"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       KeyDown="PiPromptBox_OnKeyDown" />
              <Button Grid.Column="1" x:Name="PiSendButton" Content="Send" Click="SendPrompt_OnClick" />
              <Button Grid.Column="2" x:Name="PiCancelButton" Content="Cancel" Click="CancelPrompt_OnClick" IsEnabled="False" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Settings: only genuine, working controls. -->
      <ScrollViewer x:Name="SettingsPanel" IsVisible="False"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
          <TextBlock Text="Preferences" FontSize="16" FontWeight="SemiBold" />
          <CheckBox x:Name="SettingsAutoScrollCheck" Content="Auto-scroll conversation"
                    IsCheckedChanged="SettingsAutoScrollCheck_OnChanged" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Detail level" VerticalAlignment="Center"
                       ToolTip.Tip="Compact hides tool detail rows. Detailed (default) shows operations inline. Full trace adds diagnostics." />
            <ComboBox Grid.Column="1" x:Name="VisibilityCombo" MinWidth="160"
                      SelectionChanged="VisibilityCombo_OnChanged" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Theme" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="ThemeCombo" MinWidth="160"
                      SelectionChanged="ThemeCombo_OnChanged" />
          </Grid>
          <TextBlock Text="Managed locations" FontWeight="SemiBold" />
          <TextBlock x:Name="ManagedPathsText" Text="" Foreground="#AAB2BF" FontSize="12"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open sessions folder" Click="OpenSessions_OnClick" />
            <Button Content="Open registry folder" Click="OpenRegistry_OnClick" />
          </StackPanel>
          <TextBlock Text="Workspace registration" FontWeight="SemiBold" />
          <Button x:Name="AddWorkspaceButton" Content="Add project…" Click="AddWorkspace_OnClick"
                  HorizontalAlignment="Left" />
          <StackPanel x:Name="PendingConfirmPanel" Spacing="6" IsVisible="False">
            <TextBlock x:Name="PendingConfirmText" Text="" Foreground="#E5C07B" FontSize="12"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Confirm registration" Click="ConfirmWorkspace_OnClick" />
              <Button Content="Cancel" Click="CancelWorkspace_OnClick" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="Engine" FontWeight="SemiBold" />
          <TextBlock x:Name="PiInfoText" Text="Pi engine not connected."
                     Foreground="#AAB2BF" FontSize="12" TextWrapping="Wrap" />
          <TextBlock x:Name="AppVersionText" Text="" Foreground="#AAB2BF" FontSize="12"
                     TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Shared quiet status: connection, model, action feedback. All pages. -->
    <Border Grid.Row="3" BorderBrush="#343B47" BorderThickness="1" CornerRadius="8" Padding="8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
        <Ellipse x:Name="ConnectionDot" Width="10" Height="10" Fill="#6B7280"
                 VerticalAlignment="Center" ToolTip.Tip="Connection state" />
        <TextBlock x:Name="PiConnectionState" Grid.Column="1" Text="Disconnected"
                   Foreground="#AAB2BF" FontSize="12" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Grid.Column="2" Text="Select a workspace, then Connect."
                   Foreground="#AAB2BF" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
        <TextBlock x:Name="PiModelText" Grid.Column="3" Text="Pi engine not connected."
                   Foreground="#AAB2BF" FontSize="12" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
