<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:AgentX.App"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:core="using:AgentX.Core"
        x:Class="AgentX.App.MainWindow"
        Title="Agent X"
        Width="1200" Height="800" MinWidth="720" MinHeight="480"
        Background="{DynamicResource Ax.Bg}"
        FontFamily="{DynamicResource Ax.ChromeFont}"
        Opened="MainWindow_OnOpened"
        Activated="MainWindow_OnActivated">
  <Window.Styles>
    <!-- B7 chrome: compact tabs, 28px icon buttons, rail selection pill. -->
    <Style Selector="TabStripItem">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.AxIconBtn">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.AxIconBtn:pointerover">
      <Setter Property="Background" Value="{DynamicResource Ax.Surface2}" />
    </Style>
    <Style Selector="Button.AxIconBtn:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="ToggleButton.NavBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.NavBtn:checked">
      <Setter Property="Background" Value="{DynamicResource Ax.RailSelected}" />
    </Style>
    <Style Selector="ToggleButton.NavBtn:pointerover:not(:checked)">
      <Setter Property="Background" Value="{DynamicResource Ax.Surface2}" />
    </Style>
    <!-- Selection fills are driven by the Fluent theme resource overrides in
         AxTheme.Apply (verified at runtime: template-child selectors do not
         beat the v12.1.4 ControlTheme). Root setters above remain. -->
  </Window.Styles>
  <Grid Margin="12,10,12,8" RowSpacing="0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,*,Auto">
    <!-- Identity header (approved shell). WorkspaceTabs stays in the tree,
         invisible, as the single selection model behind the worker cards. -->
    <TabStrip x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabs_OnChanged" IsVisible="False" />
    <Grid Grid.Row="0" Grid.ColumnSpan="2" RowDefinitions="Auto,Auto">
      <!-- Brand cell matches the rail width (AxLayout.RailWidth): the
           rabbit centres exactly over the rail icons, and the brand text
           starts exactly on the content-column datum. One width, both
           alignments — no per-element offsets. -->
      <Grid Grid.Row="0" ColumnDefinitions="48,Auto,*,Auto" ColumnSpacing="8">
        <app:AxIcon x:Name="BrandIcon" Kind="Rabbit" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <StackPanel x:Name="BrandText" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Agent X" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="3" Classes="AxIconBtn" Click="SearchButton_OnClick"
                ToolTip.Tip="Find in conversation" AutomationProperties.Name="Find in conversation">
          <app:AxIcon Kind="Search" />
        </Button>
      </Grid>
      <Border x:Name="HeaderDivider" Grid.Row="1" BorderBrush="{DynamicResource Ax.Border}" BorderThickness="0,0,0,1" Margin="0,8,0,0" />
    </Grid>

    <!-- Left rail: icon-only destinations (Overview, Feed, Settings bottom). -->
    <!-- Approved shell: narrow, shared icon size, selected pill + green icon. -->
    <!-- Rail padding is top-only: the content gutter (AxLayout) is the
         single separator, so rail icons centre on the rail datum and the
         cards meet one clean 8px gap. -->
    <Border Grid.Row="1" Grid.Column="0" Padding="0,8,0,0" Width="48">
      <DockPanel x:Name="NavRail" LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <ToggleButton x:Name="NavOverview" Classes="NavBtn" Click="Nav_OnClick" Width="40" Height="40"
                        ToolTip.Tip="Overview" AutomationProperties.Name="Overview">
            <app:AxIcon x:Name="NavOverviewIcon" Kind="Grid" Width="18" Height="18" />
          </ToggleButton>
          <ToggleButton x:Name="NavLive" Classes="NavBtn" Click="Nav_OnClick" Width="40" Height="40"
                        ToolTip.Tip="Feed" AutomationProperties.Name="Feed">
            <app:AxIcon x:Name="NavLiveIcon" Kind="Chat" Width="18" Height="18" />
          </ToggleButton>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8">
          <ToggleButton x:Name="NavSettings" Classes="NavBtn" Click="Nav_OnClick" Width="40" Height="40"
                        ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
            <app:AxIcon x:Name="NavSettingsIcon" Kind="Settings" Width="18" Height="18" />
          </ToggleButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content column: worker cards, divider, then the pages. Cards,
         divider, page content and (on Feed) the composer share the same
         left/right edges. Pages keep their controls so scroll, selection,
         composer input and feed survive page switches. -->
    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="0" Margin="8,8,0,0">
      <Grid x:Name="CardStrip" Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <ScrollViewer Grid.Column="0" x:Name="CardScroller" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ContextCards" Orientation="Horizontal" Spacing="8" />
        </ScrollViewer>
        <Button Grid.Column="1" x:Name="AddContextButton" Classes="AxIconBtn" Click="AddContextButton_OnClick"
                ToolTip.Tip="Add project" AutomationProperties.Name="Add project"
                VerticalAlignment="Center" MinWidth="32" MinHeight="40">
          <app:AxIcon Kind="Add" />
        </Button>
      </Grid>
      <Border x:Name="CardsDivider" Grid.Row="1" BorderBrush="{DynamicResource Ax.Border}" BorderThickness="0,0,0,1" Margin="0,8,0,0" />
      <Grid Grid.Row="2">
      <!-- Overview: supervision dashboard (B2). Every value is observed:
           identity, connection, attention, milestones, engine, telemetry,
           activity. Quiet empty states wherever data is absent. Session map
           and packet tools survive under Advanced diagnostics. -->
      <ScrollViewer x:Name="OverviewPanel" IsVisible="False"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <!-- Viewport fill up to the reading cap (AxLayout): Stretch spans
             the viewport, MaxWidth caps it — empty and populated share one
             width. The panel-fill Inspector check guards this. -->
        <StackPanel x:Name="OverviewContent" Spacing="8" MaxWidth="900" HorizontalAlignment="Stretch">
          <!-- Page header: deliberate top air, stronger title, status on
               the same rhythm. No enclosing box. -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
            <TextBlock Text="Overview" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse x:Name="OvStateDot" Width="8" Height="8" Fill="#6B7280" VerticalAlignment="Center" />
              <TextBlock x:Name="OvStateText" Text="Not connected" FontSize="12"
                         Foreground="{DynamicResource Ax.Muted}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <TextBlock x:Name="OvAttentionText" Text="No attention requested."
                     Foreground="{DynamicResource Ax.Green}" FontSize="13" TextWrapping="Wrap" />
          <Border BorderBrush="{DynamicResource Ax.Border}" BorderThickness="1"
                  CornerRadius="{DynamicResource Ax.Radius}" Padding="12"
                  Background="{DynamicResource Ax.Surface}">
            <StackPanel Spacing="6">
              <TextBlock Text="Current mission" FontSize="13" FontWeight="SemiBold" />
              <TextBlock x:Name="OvMissionTitle" Text="No mission data yet." FontSize="13" TextWrapping="Wrap" />
              <TextBlock x:Name="OvMissionDetail" Text="Milestones appear as you work."
                         Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap" />
              <StackPanel x:Name="OvMissionEvidence" Spacing="4" />
            </StackPanel>
          </Border>
          <Grid x:Name="OvDualGrid" ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="8">
            <Border x:Name="OvModelCard" Grid.Column="0" BorderBrush="{DynamicResource Ax.Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource Ax.Radius}" Padding="12"
                    Background="{DynamicResource Ax.Surface}">
              <StackPanel Spacing="4">
                <TextBlock Text="Model &amp; session" FontSize="12" Foreground="{DynamicResource Ax.Muted}" />
                <TextBlock x:Name="OvModelName" Text="—" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="OvModelDetail" Text="Pi engine not connected."
                           Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="OvSessionName" Text="No session file yet."
                           Foreground="{DynamicResource Ax.Muted}" FontSize="12"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <Border x:Name="OvVerifyCard" Grid.Column="1" BorderBrush="{DynamicResource Ax.Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource Ax.Radius}" Padding="12"
                    Background="{DynamicResource Ax.Surface}">
              <StackPanel Spacing="4">
                <TextBlock Text="Verification" FontSize="12" Foreground="{DynamicResource Ax.Muted}" />
                <TextBlock x:Name="OvVerifyTitle" Text="Awaiting evidence" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="OvVerifyDetail" Text="No latest verified run."
                           Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
          <Border BorderBrush="{DynamicResource Ax.Border}" BorderThickness="1"
                  CornerRadius="{DynamicResource Ax.Radius}" Padding="12"
                  Background="{DynamicResource Ax.Surface}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="Usage" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Pi telemetry" FontSize="11"
                           Foreground="{DynamicResource Ax.Muted}" VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Name="OvUsageLine" Text="Awaiting first settled run."
                         FontSize="12" TextWrapping="Wrap" />
              <ProgressBar x:Name="OvContextBar" IsVisible="False" Minimum="0" Maximum="100" Height="6"
                           Foreground="{DynamicResource Ax.Green}" Background="{DynamicResource Ax.Surface2}" BorderThickness="0" />
              <TextBlock x:Name="OvCostLine" Text="Est. cost: not available."
                         Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="Recent activity" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Selected agent only" FontSize="11"
                       Foreground="{DynamicResource Ax.Muted}" VerticalAlignment="Center" />
          </Grid>
          <StackPanel x:Name="OvActivityList" Spacing="0" />
          <Expander Header="Advanced diagnostics" IsExpanded="False" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
              <Expander Header="Session map detail" IsExpanded="False" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                  <SelectableTextBlock x:Name="SessionMapText" Text="Connect to Pi to build the session map."
                                         TextWrapping="Wrap" FontSize="12" />
                  <Button Content="Copy session map" Click="CopySessionMap_OnClick"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Expander>
              <Expander Header="Packet tools" IsExpanded="False" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                  <TextBlock Text="Large-packet transcript import, preserved byte-for-byte."
                             Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap" />
                  <WrapPanel Orientation="Horizontal" ItemSpacing="8">
                    <Button Content="Paste packet" Click="PastePacket_OnClick" />
                    <Button Content="Load 100k" Click="LoadSample_OnClick" />
                    <Button Content="Load 25 MiB" Click="Load25MiB_OnClick" />
                    <Button Content="Load 1M" Click="LoadMillionSample_OnClick" />
                    <Button Content="Copy full text" Click="CopyFullText_OnClick" />
                    <Button Content="Export full text" Click="ExportFullText_OnClick" />
                  </WrapPanel>
                  <ListBox x:Name="TranscriptList" Background="Transparent" BorderThickness="0"
                           MinHeight="120" MaxHeight="260">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="core:TranscriptLine">
                        <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource Ax.MonoFont}"
                                   FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Margin="6,2" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <!-- Live: contextual toolbar + dominant conversation + anchored composer. -->
      <Grid x:Name="LivePanel" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
        <Border Grid.Row="0" x:Name="FindBar" IsVisible="False" BorderBrush="{DynamicResource Ax.Border}"
                BorderThickness="1" CornerRadius="{DynamicResource Ax.Radius}" Padding="8,4"
                Background="{DynamicResource Ax.Surface}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <app:AxIcon Kind="Search" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBox x:Name="FindBox" PlaceholderText="Find in conversation" MinWidth="200"
                     KeyDown="FindBox_OnKeyDown" />
            <Button Content="Previous" Click="FindPrev_OnClick" FontSize="12" />
            <Button Content="Next" Click="FindNext_OnClick" FontSize="12" />
            <Button Content="Close" Click="FindClose_OnClick" FontSize="12" />
          </StackPanel>
        </Border>
        <!-- Feed toolbar (B2): one compact in-column action row. Same
             buttons, names, handlers and states — horizontal again, so the
             transcript keeps the full content width with no side strip. -->
        <DockPanel Grid.Row="1" LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2">
            <Button x:Name="ConnectButton" Classes="AxIconBtn" Click="ConnectPi_OnClick"
                    ToolTip.Tip="Connect the selected worker or workspace"
                    AutomationProperties.Name="Connect">
              <app:AxIcon Kind="Connect" />
            </Button>
            <Button x:Name="ReconnectButton" Classes="AxIconBtn" Click="ReconnectPi_OnClick"
                    ToolTip.Tip="Reconnect (session is persisted)"
                    AutomationProperties.Name="Reconnect">
              <app:AxIcon Kind="Reconnect" />
            </Button>
            <Button x:Name="StopButton" Classes="AxIconBtn" Click="ComposerStop_OnClick"
                    IsVisible="False" ToolTip.Tip="Stop current run (Escape)"
                    AutomationProperties.Name="Stop current run">
              <app:AxIcon Kind="Stop" Filled="True" />
            </Button>
            <Button x:Name="CopySelectedButton" Classes="AxIconBtn" Click="CopySelectedMessage_OnClick"
                    ToolTip.Tip="Copy selected message (exact bytes)"
                    AutomationProperties.Name="Copy selected message">
              <app:AxIcon Kind="Copy" />
            </Button>
          </StackPanel>
          <Button DockPanel.Dock="Right" x:Name="MoreActionsButton" Classes="AxIconBtn" ToolTip.Tip="More actions"
                  AutomationProperties.Name="More actions">
            <app:AxIcon Kind="More" Filled="True" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="DisconnectMenuItem" Header="Disconnect"
                          Click="DisconnectPi_OnClick"
                          ToolTip.Tip="Disconnect the workspace session" />
                <MenuItem x:Name="AutoScrollMenuItem" Header="Auto-scroll" ToggleType="CheckBox"
                          IsChecked="True" StaysOpenOnClick="True" Click="AutoScrollMenu_OnClick"
                          ToolTip.Tip="Follow new messages automatically" />
                <MenuItem x:Name="CopyFullMenuItem" Header="Copy full conversation"
                          Click="CopyFullConversation_OnClick"
                          ToolTip.Tip="Copy the whole transcript (exact bytes)" />
                <Separator />
                <MenuItem x:Name="RemoveWorkerMenuItem" Header="Remove worker…"
                          Click="RemoveWorker_OnClick"
                          ToolTip.Tip="Stop the selected worker's process and remove its registration (session files stay on disk)" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </DockPanel>

        <Grid Grid.Row="2">
          <ListBox x:Name="ConversationList" Background="Transparent" BorderThickness="0"
                     SelectionMode="Single" FontFamily="{DynamicResource Ax.ProseFont}"
                     FontSize="{DynamicResource Ax.FeedFontSize}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:ConversationViewItem">
                  <!-- Pi visual grammar: square user blocks (no header),
                       unboxed assistant Markdown (no header), coherent tool
                       blocks with Pi-style name headers and a 3px state
                       edge, quiet rows, violet compaction box. -->
                  <!-- Rows sit flush on the feed edge (the content datum):
                       block padding is the only inset, never a second
                       margin — no double-indent against cards/composer. -->
                  <StackPanel Spacing="2" Margin="0,4"
                              AutomationProperties.Name="{Binding Header}">
                    <!-- User: tinted block with an accent edge. Body renders
                         through the same safe MarkdownLite parser as assistant
                         rows (Lucy B7 review); the fallback keeps raw text for
                         empty/unparsed rows. Copy is always byte-exact FullText
                         from the Core feed, never this rendered view. -->
                    <Grid IsVisible="{Binding IsUser}" ColumnDefinitions="3,*">
                      <Border Background="{Binding EdgeBrush}" CornerRadius="2,0,0,2" />
                      <Border Grid.Column="1" Background="{Binding StateBrush}"
                              CornerRadius="{DynamicResource Ax.Radius}" Padding="10,8">
                        <StackPanel Spacing="2">
                          <app:MarkdownView Markdown="{Binding Markdown}" TextWrapping="Wrap"
                                            FontSize="14" />
                          <SelectableTextBlock IsVisible="{Binding Markdown, Converter={x:Static conv:ObjectConverters.IsNull}}"
                                                 Text="{Binding DisplayText}" TextWrapping="Wrap"
                                                 FontFamily="{DynamicResource Ax.ProseFont}"
                                                 FontSize="{DynamicResource Ax.FeedFontSize}"
                                                 LineHeight="{DynamicResource Ax.FeedLineHeight}" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <StackPanel IsVisible="{Binding IsAssistant}" Spacing="2">
                      <app:MarkdownView Markdown="{Binding Markdown}" TextWrapping="Wrap"
                                            FontSize="14" />
                      <SelectableTextBlock IsVisible="{Binding Markdown, Converter={x:Static conv:ObjectConverters.IsNull}}"
                                                 Text="{Binding DisplayText}" TextWrapping="Wrap"
                                                 FontFamily="{DynamicResource Ax.ProseFont}"
                                                 FontSize="{DynamicResource Ax.FeedFontSize}"
                                                 LineHeight="{DynamicResource Ax.FeedLineHeight}" />
                    </StackPanel>
                    <!-- Tool: tinted block, muted hairline, 3px state edge,
                         Pi name header + dim suffix, diff-tinted mono body. -->
                    <Grid IsVisible="{Binding IsTool}" ColumnDefinitions="3,*">
                      <Border Background="{Binding EdgeBrush}" CornerRadius="2,0,0,2" />
                      <Border Grid.Column="1" Background="{Binding StateBrush}"
                              BorderBrush="{DynamicResource Ax.Border}" BorderThickness="0,1,1,1"
                              CornerRadius="{DynamicResource Ax.Radius}" Padding="10,8">
                        <StackPanel Spacing="4">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding ToolName}" Foreground="{DynamicResource Ax.Text}"
                                       FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="{Binding ToolSuffix}" Foreground="{DynamicResource Ax.Dim}"
                                       FontSize="11" VerticalAlignment="Center" />
                          </StackPanel>
                          <app:MarkdownView MonoText="{Binding DisplayText}" DiffTint="True"
                                              TextWrapping="Wrap" FontSize="13" />
                          <Button Content="{Binding ExpandLabel}" IsVisible="{Binding CanExpand}"
                                  Click="ToolExpand_OnClick" HorizontalAlignment="Left"
                                  FontSize="11" Foreground="{DynamicResource Ax.Blue}"
                                  Background="Transparent" BorderThickness="0" Padding="0" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Border IsVisible="{Binding IsCompaction}" Background="#37294D"
                            CornerRadius="{DynamicResource Ax.Radius}" Padding="10,8">
                      <app:MarkdownView MonoText="{Binding DisplayText}" TextWrapping="Wrap"
                                            FontSize="13" />
                    </Border>
                    <StackPanel IsVisible="{Binding IsPlainSystemRow}" Spacing="2">
                      <app:MarkdownView MonoText="{Binding DisplayText}" TextWrapping="Wrap"
                                            FontSize="13" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          <!-- Restrained empty state: one state-aware hint line. No tutorial
               card, no suggestion buttons; the composer below stays the
               obvious starting point. -->
          <StackPanel x:Name="EmptyStatePanel" IsVisible="False" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Spacing="10" MaxWidth="620">
            <TextBlock x:Name="EmptyStateText" Text="Connect a workspace, then ask your first question."
                       Foreground="{DynamicResource Ax.Muted}" FontSize="13" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <!-- B1: suggestions removed — the empty state is one hint line. -->
          </StackPanel>
        </Grid>

        <Border x:Name="ComposerBox" Grid.Row="3" BorderBrush="{DynamicResource Ax.Border}" BorderThickness="1"
                CornerRadius="{DynamicResource Ax.Radius}" Padding="8"
                Background="{DynamicResource Ax.Surface}">
          <StackPanel Spacing="6">
            <TextBlock x:Name="PiRunStatus" Text="" Foreground="{DynamicResource Ax.Muted}"
                       FontSize="12" TextWrapping="Wrap" />
            <!-- The text box is the interface: full composer width, keyboard-first.
                 Chord + Escape handled in code (PreviewKeyDown tunnel): XAML cannot
                 attach tunnel events. The only visible Send/Stop surface is the context
                 menu (mouse right-click or Shift+F10/Menu key) — no permanent buttons. -->
            <!-- Composer row: the box takes the width and grows upward with
                 content (Auto row at the page bottom); the send chord stays
                 visible at the right, muted. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" x:Name="PiPromptBox" PlaceholderText="Ask Pi anything…" TextChanged="PiPromptBox_OnTextChanged"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="28" MaxHeight="220"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="Transparent" VerticalContentAlignment="Center"
                     ContextRequested="ComposerMenu_OnContextRequested">
              <TextBox.ContextFlyout>
                <!-- Opened programmatically at the CONTROL (see ContextRequested
                     below): a pointer-anchored flyout grows down-right off the
                     window and clips Send/Stop, while a control-anchored one flips
                     above the composer with every item visible — identical for
                     mouse and keyboard. -->
                <MenuFlyout Placement="TopEdgeAlignedLeft">
                  <MenuItem Header="Cut" InputGesture="Ctrl+X" Click="ComposerCut_OnClick" />
                  <MenuItem Header="Copy" InputGesture="Ctrl+C" Click="ComposerCopy_OnClick" />
                  <MenuItem Header="Paste" InputGesture="Ctrl+V" Click="ComposerPaste_OnClick" />
                  <MenuItem Header="Select all" InputGesture="Ctrl+A" Click="ComposerSelectAll_OnClick" />
                  <Separator />
                  <MenuItem x:Name="ComposerSendItem" Header="Send message" InputGesture="Ctrl+Enter" Click="ComposerSend_OnClick" />
                  <MenuItem x:Name="ComposerStopItem" Header="Stop current run" InputGesture="Escape" Click="ComposerStop_OnClick" />
                </MenuFlyout>
              </TextBox.ContextFlyout>
              </TextBox>
              <!-- Send/Stop composer button (B1): one control, two modes. Idle
                   it sends through the single tested path (disabled unless the
                   guards pass); during a run it becomes Stop, so a click can
                   never send and cancel at once. The chord stays discoverable
                   in the tooltip and the context menu. Bottom-aligned so
                   composer growth never knocks it loose. -->
              <!-- Centred on the input row (not bottom-anchored with a magic
                   margin): both controls share the row centre exactly, at any
                   composer height, so the Inspector's send-input datum holds
                   structurally. -->
              <Button Grid.Column="1" x:Name="ComposerSendButton" Classes="AxIconBtn"
                      Click="ComposerSendButton_OnClick" Width="32" Height="32"
                      VerticalAlignment="Center" IsEnabled="False"
                      ToolTip.Tip="Send message (Ctrl+Enter)"
                      AutomationProperties.Name="Send message">
                <app:AxIcon x:Name="ComposerSendIcon" Kind="Send" Width="16" Height="16" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Settings: only genuine, working controls. -->
      <ScrollViewer x:Name="SettingsPanel" IsVisible="False"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Stretch">
          <TextBlock Text="Preferences" FontSize="16" FontWeight="SemiBold" />
          <CheckBox x:Name="SettingsAutoScrollCheck" Content="Auto-scroll conversation"
                    IsCheckedChanged="SettingsAutoScrollCheck_OnChanged" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Detail level" VerticalAlignment="Center"
                       ToolTip.Tip="Compact hides tool detail rows. Detailed (default) shows operations inline. Full trace adds diagnostics." />
            <ComboBox Grid.Column="1" x:Name="VisibilityCombo" MinWidth="160"
                      SelectionChanged="VisibilityCombo_OnChanged" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Theme" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="ThemeCombo" MinWidth="160"
                      SelectionChanged="ThemeCombo_OnChanged" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Appearance" VerticalAlignment="Center"
                       ToolTip.Tip="Visual treatment: same layout and behaviour, three professional finishes." />
            <ComboBox Grid.Column="1" x:Name="TreatmentCombo" MinWidth="160"
                      SelectionChanged="TreatmentCombo_OnChanged" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Feed style" VerticalAlignment="Center"
                       ToolTip.Tip="Feed typography: Studio or Operator. Same content and Pi colours — different voice." />
            <ComboBox Grid.Column="1" x:Name="FeedCombo" MinWidth="160"
                      SelectionChanged="FeedCombo_OnChanged" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Feed size" VerticalAlignment="Center"
                       ToolTip.Tip="Feed prose size in px (13–16). Technical text sits one step under." />
            <ComboBox Grid.Column="1" x:Name="FeedSizeCombo" MinWidth="160"
                      SelectionChanged="FeedSizeCombo_OnChanged" />
          </Grid>
          <TextBlock Text="Managed locations" FontWeight="SemiBold" />
          <TextBlock x:Name="ManagedPathsText" Text="" Foreground="{DynamicResource Ax.Muted}"
                     FontSize="12" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open sessions folder" Click="OpenSessions_OnClick" />
            <Button Content="Open registry folder" Click="OpenRegistry_OnClick" />
          </StackPanel>
          <TextBlock Text="Workspace registration" FontWeight="SemiBold" />
          <Button x:Name="AddWorkspaceButton" Content="Add project…" Click="AddWorkspace_OnClick"
                  HorizontalAlignment="Left" />
          <StackPanel x:Name="PendingConfirmPanel" Spacing="6" IsVisible="False">
            <TextBlock x:Name="PendingConfirmText" Text="" Foreground="{DynamicResource Ax.Yellow}"
                       FontSize="12" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Confirm registration" Click="ConfirmWorkspace_OnClick" />
              <Button Content="Create worker here" Click="CreateWorker_OnClick"
                      ToolTip.Tip="Create an independent Pi worker for the staged folder (separate process and session)" />
              <Button Content="Cancel" Click="CancelWorkspace_OnClick" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="Engine" FontWeight="SemiBold" />
          <TextBlock x:Name="PiInfoText" Text="Pi engine not connected."
                     Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock x:Name="AppVersionText" Text="" Foreground="{DynamicResource Ax.Muted}"
                     FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
      </Grid>
    </Grid>

    <!-- Pi-style footer: working indicator, clickable directory, genuine
         status, usage, and engine segments. Full width, all pages. -->
    <!-- Left gutter matches the content column (AxLayout.ContentLeft):
         the footer divider starts exactly under the cards divider. -->
    <Border x:Name="FooterBar" Grid.Row="2" Grid.Column="1" Margin="8,0,0,0" BorderBrush="{DynamicResource Ax.Border}"
            BorderThickness="0,1,0,0" Padding="0,6,0,0" Background="Transparent">
      <StackPanel Spacing="2">
        <StackPanel x:Name="FooterTransient" />
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
            <app:AxIcon Grid.Column="0" Kind="Branch" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="FooterContextText" Text="Main" FontSize="12"
                       Foreground="{DynamicResource Ax.Muted}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </Grid>
          <TextBlock Grid.Column="1" x:Name="FooterEngineText" FontSize="12"
                     Foreground="{DynamicResource Ax.Muted}" VerticalAlignment="Center"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" x:Name="NoticeToggle" Content="i" Width="20" Height="20"
                  FontSize="11" Padding="0" CornerRadius="10" BorderThickness="1"
                  BorderBrush="{DynamicResource Ax.Muted}" Background="Transparent"
                  Foreground="{DynamicResource Ax.Muted}" VerticalAlignment="Center"
                  IsVisible="False" Click="NoticeToggle_OnClick"
                  ToolTip.Tip="Show notice" AutomationProperties.Name="Show notice" />
        </Grid>
        <!-- Legacy footer segments: hidden write-model for Checkpoint A.
             StatusText is reparented into FooterTransient in code so all
             existing writes keep working; the compact row above is the
             only other visible footer. -->
        <StackPanel IsVisible="False">
        <StackPanel x:Name="WorkingRow" IsVisible="False" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Working" Foreground="{DynamicResource Ax.Blue}" FontSize="12"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="PiActivityText" Text="" Foreground="{DynamicResource Ax.Green}"
                     FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <Button x:Name="DirectoryButton" Grid.Column="0"
                  Click="DirectoryButton_OnClick"
                  ToolTip.Tip="Working directory — opens the folder picker (guarded while connected)"
                  AutomationProperties.Name="Working directory"
                  Foreground="{DynamicResource Ax.Cyan}" Background="Transparent" BorderThickness="0"
                  Padding="4,0" FontSize="12" VerticalAlignment="Center">
            <!-- Trimmable path: long working directories ellipsize instead
                 of crowding the status, connection and engine segments. -->
            <TextBlock x:Name="DirectoryButtonText" Text="Select a workspace…"
                       TextTrimming="CharacterEllipsis" MaxWidth="440" />
          </Button>
          <TextBlock x:Name="StatusText" Grid.Column="1" Text="Select a workspace, then Connect."
                     Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Ellipse x:Name="ConnectionDot" Grid.Column="2" Width="10" Height="10" Fill="#6B7280"
                   VerticalAlignment="Center" ToolTip.Tip="Connection state" />
          <TextBlock x:Name="PiConnectionState" Grid.Column="3" Text="Disconnected"
                     Foreground="{DynamicResource Ax.Muted}" FontSize="12"
                     VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock x:Name="UsageText" Grid.Column="0" Text="messages —"
                     Foreground="{DynamicResource Ax.Muted}" FontSize="12"
                     VerticalAlignment="Center"
                     ToolTip.Tip="Genuine engine message count. Token/cost context is unavailable." />
          <Border Grid.Column="1" />
          <Button x:Name="ModelButton" Grid.Column="2" Content="Model: —"
                  Click="ModelButton_OnClick"
                  ToolTip.Tip="Engine model (selection pending the Core operation)"
                  AutomationProperties.Name="Engine model"
                  Foreground="{DynamicResource Ax.Muted}" Background="Transparent" BorderThickness="0"
                  Padding="4,0" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="•" Foreground="#6B7280" FontSize="12"
                     VerticalAlignment="Center" />
          <Button x:Name="ThinkingButton" Grid.Column="4" Content="Thinking: —"
                  Click="ThinkingButton_OnClick"
                  ToolTip.Tip="Thinking level (selection pending the Core operation)"
                  AutomationProperties.Name="Thinking level"
                  Foreground="{DynamicResource Ax.Muted}" Background="Transparent" BorderThickness="0"
                  Padding="4,0" FontSize="12" VerticalAlignment="Center" />
        </Grid>
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- Layout Inspector overlay (B2, developer-only): painted last so it
         sits above everything; never hit-testable, sized by the grid so it
         cannot change layout. F12 toggles; hidden otherwise. -->
    <Canvas x:Name="LayoutOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2"
            IsVisible="False" IsHitTestVisible="False" />
  </Grid>
</Window>
