<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:AgentX.App"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:core="using:AgentX.Core"
        x:Class="AgentX.App.MainWindow"
        Title="Agent X"
        Width="1200" Height="800" MinWidth="720" MinHeight="480"
        Background="{DynamicResource Ax.Bg}"
        FontFamily="{DynamicResource Ax.ChromeFont}"
        Opened="MainWindow_OnOpened"
        Activated="MainWindow_OnActivated">
  <Window.Styles>
    <!-- B7 chrome: compact tabs, 28px icon buttons, rail selection pill. -->
    <Style Selector="TabStripItem">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.AxIconBtn">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.AxIconBtn:pointerover">
      <Setter Property="Background" Value="{DynamicResource Ax.Surface2}" />
    </Style>
    <Style Selector="Button.AxIconBtn:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="ToggleButton.NavBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="ToggleButton.NavBtn:checked">
      <Setter Property="Background" Value="{DynamicResource Ax.Surface2}" />
    </Style>
    <Style Selector="ToggleButton.NavBtn:pointerover">
      <Setter Property="Background" Value="{DynamicResource Ax.Surface2}" />
    </Style>
    <!-- Selection fills are driven by the Fluent theme resource overrides in
         AxTheme.Apply (verified at runtime: template-child selectors do not
         beat the v12.1.4 ControlTheme). Root setters above remain. -->
  </Window.Styles>
  <Grid Margin="8" RowSpacing="6" ColumnDefinitions="Auto,*" RowDefinitions="Auto,*,Auto">
    <!-- Top row: compact worker tabs + add. Display labels only (Main,
         Agent ONE…): storage identity and session ids stay in tooltips. -->
    <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
        <TabStrip x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabs_OnChanged" />
      </ScrollViewer>
      <Button Grid.Column="1" Classes="AxIconBtn" Click="AddWorkspace_OnClick"
              ToolTip.Tip="Add project" AutomationProperties.Name="Add project"
              VerticalAlignment="Center">
        <app:AxIcon Kind="Add" />
      </Button>
    </Grid>

    <!-- Left rail: vector icon navigation (Live default, Overview, Settings
         anchored at the bottom). Collapsed 52px, expanded 180px. -->
    <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource Ax.Border}"
            BorderThickness="0,0,1,0" Padding="0,4,4,4" Margin="0,0,8,0">
      <DockPanel x:Name="NavRail" Width="52" LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <ToggleButton x:Name="NavLive" Classes="NavBtn" Click="Nav_OnClick"
                        ToolTip.Tip="Live conversation" AutomationProperties.Name="Live">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <app:AxIcon Kind="Live" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock x:Name="NavLiveLabel" Text="Live" FontSize="13"
                         VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="NavOverview" Classes="NavBtn" Click="Nav_OnClick"
                        ToolTip.Tip="Overview" AutomationProperties.Name="Overview">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <app:AxIcon Kind="Overview" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock x:Name="NavOverviewLabel" Text="Overview" FontSize="13"
                         VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="4">
          <ToggleButton x:Name="NavSettings" Classes="NavBtn" Click="Nav_OnClick"
                        ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <app:AxIcon Kind="Settings" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock x:Name="NavSettingsLabel" Text="Settings" FontSize="13"
                         VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Button x:Name="NavCollapse" Classes="NavBtn" Click="NavCollapse_OnClick"
                  ToolTip.Tip="Expand navigation" AutomationProperties.Name="Expand navigation">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock x:Name="NavCollapseGlyph" Text="&#xBB;" FontSize="16" Width="16"
                         TextAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource Ax.Muted}" />
              <TextBlock x:Name="NavCollapseLabel" Text="Expand" FontSize="13"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pages. Only one visible; controls persist so scroll, selection,
         composer input and feed survive page switches. -->
    <!-- Centre: the Pi conversation takes the remaining room. -->
    <Grid Grid.Row="1" Grid.Column="1">
      <!-- Overview: real workspace state, activity, evidence. No invented cards. -->
      <ScrollViewer x:Name="OverviewPanel" IsVisible="False"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
          <TextBlock Text="Workspace" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="WorkspaceDetailText" Text="Select a workspace, then Connect."
                     Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock x:Name="OverviewConnectionText" Text="Not connected."
                     Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="Session file" FontWeight="SemiBold" />
          <TextBlock x:Name="OverviewSessionFileText" Text="No session file yet."
                     Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="Recent activity" FontWeight="SemiBold" />
          <TextBlock x:Name="OverviewFactsText" Text="Nothing observed yet."
                     Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap" />
          <StackPanel x:Name="OverviewMilestones" Spacing="4" />
          <Expander Header="Session map detail" IsExpanded="False" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
              <SelectableTextBlock x:Name="SessionMapText" Text="Connect to Pi to build the session map."
                                     TextWrapping="Wrap" FontSize="12" />
              <Button Content="Copy session map" Click="CopySessionMap_OnClick"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Expander>
          <Expander Header="Packet tools" IsExpanded="False" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
              <TextBlock Text="Large-packet transcript import, preserved byte-for-byte."
                         Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal" ItemSpacing="8">
                <Button Content="Paste packet" Click="PastePacket_OnClick" />
                <Button Content="Load 100k" Click="LoadSample_OnClick" />
                <Button Content="Load 25 MiB" Click="Load25MiB_OnClick" />
                <Button Content="Load 1M" Click="LoadMillionSample_OnClick" />
                <Button Content="Copy full text" Click="CopyFullText_OnClick" />
                <Button Content="Export full text" Click="ExportFullText_OnClick" />
              </WrapPanel>
              <ListBox x:Name="TranscriptList" Background="Transparent" BorderThickness="0"
                       MinHeight="120" MaxHeight="260">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="core:TranscriptLine">
                    <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource Ax.MonoFont}"
                               FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Margin="6,2" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <!-- Live: contextual toolbar + dominant conversation + anchored composer. -->
      <Grid x:Name="LivePanel" RowDefinitions="Auto,*,Auto" RowSpacing="6">
        <!-- Contextual actions: frequent actions as icons, occasional or
             destructive ones in the overflow menu. No dead buttons. -->
        <DockPanel Grid.Row="0" LastChildFill="False" MinHeight="32">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2">
            <Button x:Name="ConnectButton" Classes="AxIconBtn" Click="ConnectPi_OnClick"
                    ToolTip.Tip="Connect the selected worker or workspace"
                    AutomationProperties.Name="Connect">
              <app:AxIcon Kind="Connect" />
            </Button>
            <Button x:Name="ReconnectButton" Classes="AxIconBtn" Click="ReconnectPi_OnClick"
                    ToolTip.Tip="Reconnect (session is persisted)"
                    AutomationProperties.Name="Reconnect">
              <app:AxIcon Kind="Reconnect" />
            </Button>
            <Button x:Name="StopButton" Classes="AxIconBtn" Click="ComposerStop_OnClick"
                    IsVisible="False" ToolTip.Tip="Stop current run (Escape)"
                    AutomationProperties.Name="Stop current run">
              <app:AxIcon Kind="Stop" Filled="True" />
            </Button>
            <Button x:Name="CopySelectedButton" Classes="AxIconBtn" Click="CopySelectedMessage_OnClick"
                    ToolTip.Tip="Copy selected message (exact bytes)"
                    AutomationProperties.Name="Copy selected message">
              <app:AxIcon Kind="Copy" />
            </Button>
          </StackPanel>
          <Button DockPanel.Dock="Right" Classes="AxIconBtn" ToolTip.Tip="More actions"
                  AutomationProperties.Name="More actions">
            <app:AxIcon Kind="More" Filled="True" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="DisconnectMenuItem" Header="Disconnect"
                          Click="DisconnectPi_OnClick"
                          ToolTip.Tip="Disconnect the workspace session" />
                <MenuItem x:Name="AutoScrollMenuItem" Header="Auto-scroll" ToggleType="CheckBox"
                          IsChecked="True" StaysOpenOnClick="True" Click="AutoScrollMenu_OnClick"
                          ToolTip.Tip="Follow new messages automatically" />
                <MenuItem x:Name="CopyFullMenuItem" Header="Copy full conversation"
                          Click="CopyFullConversation_OnClick"
                          ToolTip.Tip="Copy the whole transcript (exact bytes)" />
                <Separator />
                <MenuItem x:Name="RemoveWorkerMenuItem" Header="Remove worker…"
                          Click="RemoveWorker_OnClick"
                          ToolTip.Tip="Stop the selected worker's process and remove its registration (session files stay on disk)" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </DockPanel>

        <Grid Grid.Row="1">
          <Border BorderBrush="{DynamicResource Ax.Border}" BorderThickness="1"
                  CornerRadius="{DynamicResource Ax.Radius}" Padding="4"
                  Background="{DynamicResource Ax.Bg}">
            <ListBox x:Name="ConversationList" Background="Transparent" BorderThickness="0"
                     SelectionMode="Single" FontFamily="{DynamicResource Ax.ProseFont}"
                     FontSize="{DynamicResource Ax.FeedFontSize}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:ConversationViewItem">
                  <!-- Pi visual grammar: square user blocks (no header),
                       unboxed assistant Markdown (no header), coherent tool
                       blocks with Pi-style name headers and a 3px state
                       edge, quiet rows, violet compaction box. -->
                  <StackPanel Spacing="2" Margin="8,4"
                              AutomationProperties.Name="{Binding Header}">
                    <!-- User: tinted block with an accent edge. Body renders
                         through the same safe MarkdownLite parser as assistant
                         rows (Lucy B7 review); the fallback keeps raw text for
                         empty/unparsed rows. Copy is always byte-exact FullText
                         from the Core feed, never this rendered view. -->
                    <Grid IsVisible="{Binding IsUser}" ColumnDefinitions="3,*">
                      <Border Background="{Binding EdgeBrush}" CornerRadius="2,0,0,2" />
                      <Border Grid.Column="1" Background="{Binding StateBrush}"
                              CornerRadius="{DynamicResource Ax.Radius}" Padding="10,8">
                        <StackPanel Spacing="2">
                          <app:MarkdownView Markdown="{Binding Markdown}" TextWrapping="Wrap"
                                            FontSize="14" />
                          <SelectableTextBlock IsVisible="{Binding Markdown, Converter={x:Static conv:ObjectConverters.IsNull}}"
                                                 Text="{Binding DisplayText}" TextWrapping="Wrap"
                                                 FontFamily="{DynamicResource Ax.ProseFont}"
                                                 FontSize="{DynamicResource Ax.FeedFontSize}"
                                                 LineHeight="{DynamicResource Ax.FeedLineHeight}" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <StackPanel IsVisible="{Binding IsAssistant}" Spacing="2">
                      <app:MarkdownView Markdown="{Binding Markdown}" TextWrapping="Wrap"
                                            FontSize="14" />
                      <SelectableTextBlock IsVisible="{Binding Markdown, Converter={x:Static conv:ObjectConverters.IsNull}}"
                                                 Text="{Binding DisplayText}" TextWrapping="Wrap"
                                                 FontFamily="{DynamicResource Ax.ProseFont}"
                                                 FontSize="{DynamicResource Ax.FeedFontSize}"
                                                 LineHeight="{DynamicResource Ax.FeedLineHeight}" />
                    </StackPanel>
                    <!-- Tool: tinted block, muted hairline, 3px state edge,
                         Pi name header + dim suffix, diff-tinted mono body. -->
                    <Grid IsVisible="{Binding IsTool}" ColumnDefinitions="3,*">
                      <Border Background="{Binding EdgeBrush}" CornerRadius="2,0,0,2" />
                      <Border Grid.Column="1" Background="{Binding StateBrush}"
                              BorderBrush="{DynamicResource Ax.Border}" BorderThickness="0,1,1,1"
                              CornerRadius="{DynamicResource Ax.Radius}" Padding="10,8">
                        <StackPanel Spacing="4">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding ToolName}" Foreground="{DynamicResource Ax.Text}"
                                       FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="{Binding ToolSuffix}" Foreground="{DynamicResource Ax.Dim}"
                                       FontSize="11" VerticalAlignment="Center" />
                          </StackPanel>
                          <app:MarkdownView MonoText="{Binding DisplayText}" DiffTint="True"
                                              TextWrapping="Wrap" FontSize="13" />
                          <Button Content="{Binding ExpandLabel}" IsVisible="{Binding CanExpand}"
                                  Click="ToolExpand_OnClick" HorizontalAlignment="Left"
                                  FontSize="11" Foreground="{DynamicResource Ax.Blue}"
                                  Background="Transparent" BorderThickness="0" Padding="0" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Border IsVisible="{Binding IsCompaction}" Background="#37294D"
                            CornerRadius="{DynamicResource Ax.Radius}" Padding="10,8">
                      <app:MarkdownView MonoText="{Binding DisplayText}" TextWrapping="Wrap"
                                            FontSize="13" />
                    </Border>
                    <StackPanel IsVisible="{Binding IsPlainSystemRow}" Spacing="2">
                      <app:MarkdownView MonoText="{Binding DisplayText}" TextWrapping="Wrap"
                                            FontSize="13" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <!-- Restrained empty state: one state-aware hint line plus the
               composer-filling suggestions. No tutorial card; the composer
               below stays the obvious starting point. -->
          <StackPanel x:Name="EmptyStatePanel" IsVisible="False" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Spacing="10" MaxWidth="620">
            <TextBlock x:Name="EmptyStateText" Text="Connect a workspace, then ask your first question."
                       Foreground="{DynamicResource Ax.Muted}" FontSize="13" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemSpacing="8">
              <Button Content="List the top-level files and explain the layout"
                      Tag="List the top-level files in this project and explain the layout briefly."
                      Click="Suggestion_OnClick" FontSize="12" />
              <Button Content="Summarise recent changes" Tag="Summarise the recent changes in this project."
                      Click="Suggestion_OnClick" FontSize="12" />
              <Button Content="What tests exist and how do I run them"
                      Tag="What tests exist in this project and how do I run them?"
                      Click="Suggestion_OnClick" FontSize="12" />
            </WrapPanel>
          </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Ax.Border}" BorderThickness="1"
                CornerRadius="{DynamicResource Ax.Radius}" Padding="8"
                Background="{DynamicResource Ax.Surface}">
          <StackPanel Spacing="6">
            <TextBlock x:Name="PiRunStatus" Text="" Foreground="{DynamicResource Ax.Muted}"
                       FontSize="12" TextWrapping="Wrap" />
            <!-- The text box is the interface: full composer width, keyboard-first.
                 Chord + Escape handled in code (PreviewKeyDown tunnel): XAML cannot
                 attach tunnel events. The only visible Send/Stop surface is the context
                 menu (mouse right-click or Shift+F10/Menu key) — no permanent buttons. -->
            <TextBox x:Name="PiPromptBox" PlaceholderText="Ask Pi anything… (Ctrl+Enter to send)"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="220"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0"
                     Background="Transparent"
                     ContextRequested="ComposerMenu_OnContextRequested">
              <TextBox.ContextFlyout>
                <!-- Opened programmatically at the CONTROL (see ContextRequested
                     below): a pointer-anchored flyout grows down-right off the
                     window and clips Send/Stop, while a control-anchored one flips
                     above the composer with every item visible — identical for
                     mouse and keyboard. -->
                <MenuFlyout Placement="TopEdgeAlignedLeft">
                  <MenuItem Header="Cut" InputGesture="Ctrl+X" Click="ComposerCut_OnClick" />
                  <MenuItem Header="Copy" InputGesture="Ctrl+C" Click="ComposerCopy_OnClick" />
                  <MenuItem Header="Paste" InputGesture="Ctrl+V" Click="ComposerPaste_OnClick" />
                  <MenuItem Header="Select all" InputGesture="Ctrl+A" Click="ComposerSelectAll_OnClick" />
                  <Separator />
                  <MenuItem x:Name="ComposerSendItem" Header="Send message" InputGesture="Ctrl+Enter" Click="ComposerSend_OnClick" />
                  <MenuItem x:Name="ComposerStopItem" Header="Stop current run" InputGesture="Escape" Click="ComposerStop_OnClick" />
                </MenuFlyout>
              </TextBox.ContextFlyout>
            </TextBox>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Settings: only genuine, working controls. -->
      <ScrollViewer x:Name="SettingsPanel" IsVisible="False"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
          <TextBlock Text="Preferences" FontSize="16" FontWeight="SemiBold" />
          <CheckBox x:Name="SettingsAutoScrollCheck" Content="Auto-scroll conversation"
                    IsCheckedChanged="SettingsAutoScrollCheck_OnChanged" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Detail level" VerticalAlignment="Center"
                       ToolTip.Tip="Compact hides tool detail rows. Detailed (default) shows operations inline. Full trace adds diagnostics." />
            <ComboBox Grid.Column="1" x:Name="VisibilityCombo" MinWidth="160"
                      SelectionChanged="VisibilityCombo_OnChanged" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Theme" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="ThemeCombo" MinWidth="160"
                      SelectionChanged="ThemeCombo_OnChanged" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Appearance" VerticalAlignment="Center"
                       ToolTip.Tip="Visual treatment: same layout and behaviour, three professional finishes." />
            <ComboBox Grid.Column="1" x:Name="TreatmentCombo" MinWidth="160"
                      SelectionChanged="TreatmentCombo_OnChanged" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Feed style" VerticalAlignment="Center"
                       ToolTip.Tip="Feed typography: Studio or Operator. Same content and Pi colours — different voice." />
            <ComboBox Grid.Column="1" x:Name="FeedCombo" MinWidth="160"
                      SelectionChanged="FeedCombo_OnChanged" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Feed size" VerticalAlignment="Center"
                       ToolTip.Tip="Feed prose size in px (13–16). Technical text sits one step under." />
            <ComboBox Grid.Column="1" x:Name="FeedSizeCombo" MinWidth="160"
                      SelectionChanged="FeedSizeCombo_OnChanged" />
          </Grid>
          <TextBlock Text="Managed locations" FontWeight="SemiBold" />
          <TextBlock x:Name="ManagedPathsText" Text="" Foreground="{DynamicResource Ax.Muted}"
                     FontSize="12" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open sessions folder" Click="OpenSessions_OnClick" />
            <Button Content="Open registry folder" Click="OpenRegistry_OnClick" />
          </StackPanel>
          <TextBlock Text="Workspace registration" FontWeight="SemiBold" />
          <Button x:Name="AddWorkspaceButton" Content="Add project…" Click="AddWorkspace_OnClick"
                  HorizontalAlignment="Left" />
          <StackPanel x:Name="PendingConfirmPanel" Spacing="6" IsVisible="False">
            <TextBlock x:Name="PendingConfirmText" Text="" Foreground="{DynamicResource Ax.Yellow}"
                       FontSize="12" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Confirm registration" Click="ConfirmWorkspace_OnClick" />
              <Button Content="Create worker here" Click="CreateWorker_OnClick"
                      ToolTip.Tip="Create an independent Pi worker for the staged folder (separate process and session)" />
              <Button Content="Cancel" Click="CancelWorkspace_OnClick" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="Engine" FontWeight="SemiBold" />
          <TextBlock x:Name="PiInfoText" Text="Pi engine not connected."
                     Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock x:Name="AppVersionText" Text="" Foreground="{DynamicResource Ax.Muted}"
                     FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Pi-style footer: working indicator, clickable directory, genuine
         status, usage, and engine segments. Full width, all pages. -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Ax.Border}"
            BorderThickness="1" CornerRadius="{DynamicResource Ax.Radius}" Padding="8,6"
            Background="{DynamicResource Ax.Surface}">
      <StackPanel Spacing="2">
        <StackPanel x:Name="WorkingRow" IsVisible="False" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Working" Foreground="{DynamicResource Ax.Blue}" FontSize="12"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="PiActivityText" Text="" Foreground="{DynamicResource Ax.Green}"
                     FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <Button x:Name="DirectoryButton" Grid.Column="0"
                  Click="DirectoryButton_OnClick"
                  ToolTip.Tip="Working directory — opens the folder picker (guarded while connected)"
                  AutomationProperties.Name="Working directory"
                  Foreground="{DynamicResource Ax.Cyan}" Background="Transparent" BorderThickness="0"
                  Padding="4,0" FontSize="12" VerticalAlignment="Center">
            <!-- Trimmable path: long working directories ellipsize instead
                 of crowding the status, connection and engine segments. -->
            <TextBlock x:Name="DirectoryButtonText" Text="Select a workspace…"
                       TextTrimming="CharacterEllipsis" MaxWidth="440" />
          </Button>
          <TextBlock x:Name="StatusText" Grid.Column="1" Text="Select a workspace, then Connect."
                     Foreground="{DynamicResource Ax.Muted}" FontSize="12" TextWrapping="Wrap"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Ellipse x:Name="ConnectionDot" Grid.Column="2" Width="10" Height="10" Fill="#6B7280"
                   VerticalAlignment="Center" ToolTip.Tip="Connection state" />
          <TextBlock x:Name="PiConnectionState" Grid.Column="3" Text="Disconnected"
                     Foreground="{DynamicResource Ax.Muted}" FontSize="12"
                     VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock x:Name="UsageText" Grid.Column="0" Text="messages —"
                     Foreground="{DynamicResource Ax.Muted}" FontSize="12"
                     VerticalAlignment="Center"
                     ToolTip.Tip="Genuine engine message count. Token/cost context is unavailable." />
          <Border Grid.Column="1" />
          <Button x:Name="ModelButton" Grid.Column="2" Content="Model: —"
                  Click="ModelButton_OnClick"
                  ToolTip.Tip="Engine model (selection pending the Core operation)"
                  AutomationProperties.Name="Engine model"
                  Foreground="{DynamicResource Ax.Muted}" Background="Transparent" BorderThickness="0"
                  Padding="4,0" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="•" Foreground="#6B7280" FontSize="12"
                     VerticalAlignment="Center" />
          <Button x:Name="ThinkingButton" Grid.Column="4" Content="Thinking: —"
                  Click="ThinkingButton_OnClick"
                  ToolTip.Tip="Thinking level (selection pending the Core operation)"
                  AutomationProperties.Name="Thinking level"
                  Foreground="{DynamicResource Ax.Muted}" Background="Transparent" BorderThickness="0"
                  Padding="4,0" FontSize="12" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
