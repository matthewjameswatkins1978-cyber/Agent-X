<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:AgentX.App"
        xmlns:core="using:AgentX.Core"
        x:Class="AgentX.App.MainWindow"
        Title="Agent X — Transcript"
        Width="1100" Height="760" MinWidth="720" MinHeight="480"
        Background="#101318">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24" RowSpacing="16">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="Agent X" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="A fast, faithful view of the whole conversation." Foreground="#AAB2BF" />
    </StackPanel>

    <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="8">
      <Button Content="Paste packet" Click="PastePacket_OnClick" />
      <Button Content="Load 100k-line sample" Click="LoadSample_OnClick" />
      <Button Content="Load 25 MiB sample" Click="Load25MiB_OnClick" />
      <Button Content="Load 1M-line sample" Click="LoadMillionSample_OnClick" />
      <Button Content="Copy full text" Click="CopyFullText_OnClick" />
      <Button Content="Export full text" Click="ExportFullText_OnClick" />
    </WrapPanel>

    <Border Grid.Row="2" BorderBrush="#343B47" BorderThickness="1" CornerRadius="8" Padding="12">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="Pi agent" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock x:Name="PiConnectionState" Grid.Column="1" Text="Disconnected" Foreground="#AAB2BF" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="Connect" Click="ConnectPi_OnClick" />
          <Button Grid.Column="3" Content="Disconnect" Click="DisconnectPi_OnClick" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="Workspace" FontWeight="SemiBold" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" x:Name="WorkspaceCombo" MinWidth="280"
                    SelectionChanged="WorkspaceCombo_OnChanged" />
          <Button Grid.Column="2" Content="Add project…" Click="AddWorkspace_OnClick" />
          <Button Grid.Column="3" Content="Reconnect" Click="ReconnectPi_OnClick" />
        </Grid>
        <TextBlock x:Name="WorkspaceDetailText" Text="Select a workspace, then Connect." Foreground="#AAB2BF" FontSize="12" TextWrapping="Wrap" />
        <TextBlock x:Name="PiModelText" Text="Pi engine not connected." Foreground="#AAB2BF" FontSize="12" TextWrapping="Wrap" />
        <TextBlock x:Name="PiActivityText" Text="" Foreground="#7DD3A8" FontSize="12" TextWrapping="Wrap" />
        <TextBlock x:Name="PiRunStatus" Text="" Foreground="#AAB2BF" FontSize="12" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox x:Name="PiPromptBox" PlaceholderText="Ask Pi anything…" />
          <Button Grid.Column="1" x:Name="PiSendButton" Content="Send" Click="SendPrompt_OnClick" />
          <Button Grid.Column="2" x:Name="PiCancelButton" Content="Cancel" Click="CancelPrompt_OnClick" IsEnabled="False" />
        </Grid>
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
          <TextBlock Text="Conversation" FontWeight="SemiBold" VerticalAlignment="Center" />
          <CheckBox Grid.Column="1" x:Name="AutoScrollCheck" Content="Auto-scroll" IsChecked="True" />
          <Button Grid.Column="2" Content="Copy selected message" Click="CopySelectedMessage_OnClick" />
          <Button Grid.Column="3" Content="Copy full conversation" Click="CopyFullConversation_OnClick" />
        </Grid>
        <ListBox x:Name="ConversationList" MinHeight="160" MaxHeight="300"
                 SelectionMode="Single">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:ConversationViewItem">
              <StackPanel Spacing="2" Margin="6,6">
                <TextBlock Text="{Binding Header}" Foreground="{Binding RoleBrush}"
                           FontSize="11" FontWeight="SemiBold" />
                <SelectableTextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"
                                         FontSize="13" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Expander Header="Session map (current activity, milestones, files, tests)" IsExpanded="False">
          <StackPanel Spacing="8">
            <SelectableTextBlock x:Name="SessionMapText" Text="Connect to Pi to build the session map."
                                   TextWrapping="Wrap" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Copy session map" Click="CopySessionMap_OnClick" />
              <CheckBox x:Name="VerboseMapCheck" Content="Verbose milestones" IsChecked="False"
                        IsCheckedChanged="VerboseMapCheck_OnChanged" />
            </StackPanel>
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" BorderBrush="#343B47" BorderThickness="1" CornerRadius="8" Padding="8">
      <ListBox x:Name="TranscriptList" Background="Transparent" BorderThickness="0">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:TranscriptLine">
            <TextBlock Text="{Binding Text}" FontFamily="Cascadia Code, Consolas, monospace"
                       FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Margin="6,3" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="4" Text="Copy a packet, then select Paste packet."
               Foreground="#AAB2BF" TextWrapping="Wrap" />
  </Grid>
</Window>