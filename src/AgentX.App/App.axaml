<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AgentX.App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <!-- Charcoal focus edge (B1): implicit ControlTheme override. The
             Fluent :focus rule paints PART_BorderElement from a
             variant-scoped accent key that later overrides cannot reach;
             this BasedOn theme wins the nested-style tie instead, and the
             DynamicResource keeps every treatment correct. (Overriding the
             SystemAccentColor key itself crashes startup; benign keys are
             fine — both verified.) -->
        <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox"
                      BasedOn="{StaticResource {x:Type TextBox}}">
            <Style Selector="^:focus /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="{DynamicResource Ax.BorderStrong}" />
            </Style>
        </ControlTheme>
        <!-- Charcoal checkbox (B2): the checked glyph and box fill come
             from accent keys with the same reach problem. Green glyph on
             a charcoal box keeps the success voice without Windows blue. -->
        <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox"
                      BasedOn="{StaticResource {x:Type CheckBox}}">
            <Style Selector="^:checked /template/ Path#CheckGlyph">
                <Setter Property="Fill" Value="{DynamicResource Ax.Green}" />
            </Style>
            <Style Selector="^:checked /template/ Border#NormalRectangle">
                <Setter Property="Background" Value="{DynamicResource Ax.BorderStrong}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Ax.BorderStrong}" />
            </Style>
        </ControlTheme>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>